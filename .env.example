NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
LOG_LEVEL=info
DATABASE_DRIVER=pg
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estate_sales
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/estate_sales

CRON_SECRET=replace-with-at-least-32-random-characters
BLOB_READ_WRITE_TOKEN=
AUTH_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
RESEND_FROM=Estate Sales Bakersfield <accounts@example.com>
# Local/test-only capture under .tmp; deployed environments always use Resend.
AUTH_EMAIL_CAPTURE_PATH=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
VERCEL_BENCHMARK_URL=
