NODE_ENV=development
APP_ENV=local
# Server-only, Production-only release gate. Keep false unless deliberately
# operating the stable Production deployment with Stripe test resources.
PRODUCTION_BETA_MODE=false
# Explicit public-directory indexing gate; requires Production.
# Independent of Stripe payment activation. Preparation stays false.
PUBLIC_INDEXING_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Public content value from Search Console's HTML verification tag, not its G- ID.
GOOGLE_SITE_VERIFICATION=
# Syndicated/imported detail pages stay noindex until a separate content/source
# quality approval. This opt-in also requires the public launch gate above.
PUBLIC_IMPORTED_INDEXING_ENABLED=false
APP_URL=http://localhost:3000
# Owner-controlled inbox, displayed on /contact when configured.
PUBLIC_SUPPORT_EMAIL=decoratedbyriley@gmail.com
LOG_LEVEL=info
# Local development and test lifecycle operations use Development Neon only.
# This Development-only principal must own the database and have CREATEROLE;
# test commands replace it with a generated least-privilege runtime login.
DATABASE_URL=postgresql://development_user:replace-me@ep-development-identifier-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://development_user:replace-me@ep-development-identifier.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_RESOURCE_ENV=development
DEVELOPMENT_NEON_ENDPOINT_ID=ep-development-identifier
# Non-secret, authoritative collision guard. This must be the exact Production
# endpoint identifier even when the ignored Production .env file is absent.
PRODUCTION_NEON_ENDPOINT_ID=ep-production-identifier
DEVELOPMENT_DATABASE_CONFIRMATION=estate-sales-bakersfield-development-neon-test-schemas

CRON_SECRET=replace-with-at-least-32-random-characters
# Alert after 15 minutes of queued delay with the five-minute Pro schedules.
# Running-job lock alarms remain 15 minutes regardless of this setting.
JOB_MAX_QUEUE_DELAY_MINUTES=15
# Local uploads use private .local/media storage when this is blank.
# Preview and Production require their own Blob credentials.
BLOB_READ_WRITE_TOKEN=
BLOB_RESOURCE_ENV=
AUTH_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
# Private, dedicated 32-byte encryption key encoded as 64 hex characters.
# Generate independent values per environment; back up before admin enrollment.
ADMIN_MFA_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM=Estate Sales Bakersfield <accounts@example.com>
RESEND_RESOURCE_ENV=
RESEND_WEBHOOK_SECRET=
# Production-only release gate. Local development cannot dispatch campaigns.
EMAIL_CAMPAIGNS_ENABLED=false
# Local/test-only capture under .tmp; deployed environments always use Resend.
AUTH_EMAIL_CAPTURE_PATH=
# Private, server-only. Never prefix this key with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
# Opt in only when local address lookups may share the Production Geoapify quota.
LOCAL_ALLOW_SHARED_GEOAPIFY_KEY=false
# Public MapLibre style configuration. Launch default:
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Local uses the deterministic fake by default. Never copy live values here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_EXPECTED_AMOUNT=
STRIPE_EXPECTED_CURRENCY=
STRIPE_MODE=
STRIPE_RESOURCE_ENV=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
VERCEL_BENCHMARK_URL=
