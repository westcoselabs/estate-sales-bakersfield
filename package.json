{
  "name": "estate-sales-bakersfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estate and yard sale directory modular monolith",
  "engines": {
    "node": "24.11.1",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/vercel-build.ts",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "arch:check": "depcruise --config dependency-cruiser.cjs src scripts tests",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:test:reset": "tsx scripts/reset-test-database.ts",
    "db:test:check": "tsx scripts/check-test-database.ts",
    "db:verify:live": "tsx scripts/verify-live-neon.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract:blob": "vitest run --project blob-contract",
    "test:contract:email": "vitest run --project email-contract",
    "test:contract:location": "vitest run --project location-contract",
    "test:contract:image": "vitest run --project image-contract",
    "test:contract:stripe": "vitest run --project stripe-contract",
    "test:contract:blob:live": "tsx scripts/run-live-blob-contract.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test": "vitest run --project unit --project integration --project blob-contract --project email-contract --project location-contract --project image-contract --project stripe-contract",
    "auth:benchmark": "tsx scripts/benchmark-argon2.ts",
    "auth:benchmark:vercel": "tsx scripts/benchmark-vercel-argon2.ts",
    "admin:provision": "node --conditions=react-server --import tsx scripts/provision-super-admin.ts",
    "email:seed-templates": "node --conditions=react-server --import tsx scripts/seed-email-templates.ts",
    "email:seed-templates:local": "node --env-file=.env.local --conditions=react-server --import tsx scripts/seed-email-templates.ts",
    "jobs:run": "node --conditions=react-server --import tsx scripts/run-jobs.ts --once",
    "payments:reconcile": "node --conditions=react-server --import tsx scripts/reconcile-payment.ts",
    "verify:credential-free": "tsx scripts/verify.ts credential-free",
    "verify": "tsx scripts/verify.ts offline",
    "verify:live": "tsx scripts/verify.ts live",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.11",
    "@neondatabase/serverless": "1.1.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/nextjs": "10.66.0",
    "@uiw/react-codemirror": "4.25.11",
    "@vercel/blob": "2.6.1",
    "dotenv": "17.4.2",
    "maplibre-gl": "5.24.0",
    "next": "16.2.11",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "resend": "6.17.2",
    "sanitize-html": "2.17.6",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "stripe": "22.3.2",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.108.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "cpu-features",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ],
    "overrides": {
      "@hono/node-server": "2.0.11",
      "minimatch@3.1.5>brace-expansion": "1.1.12",
      "fast-uri": "3.1.4",
      "postcss": "8.5.18",
      "sharp": "0.35.3",
      "valibot": "1.4.2"
    }
  }
}
