generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  DISABLED

  @@map("account_status")
}

enum JobStatus {
  PENDING
  RUNNING
  FAILED
  SUCCEEDED
  DEAD

  @@map("job_status")
}

enum OrganizerStatus {
  INCOMPLETE
  COMPLETE

  @@map("organizer_status")
}

enum EmailDeliveryKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("email_delivery_kind")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED

  @@map("email_delivery_status")
}

enum EventType {
  ESTATE_SALE
  YARD_SALE

  @@map("event_type")
}

enum EventOrigin {
  OWNER_CREATED
  ADMIN_IMPORTED
  PARTNER_FEED

  @@map("event_origin")
}

enum AddressPrivacyMode {
  EXACT_ADDRESS
  APPROXIMATE_LOCATION
  HIDDEN_UNTIL_START

  @@map("address_privacy_mode")
}

enum EventWorkflowState {
  INCOMPLETE_DRAFT
  PREVIEW_READY
  APPROVED_FOR_PAYMENT

  @@map("event_workflow_state")
}

enum EventApprovalStatus {
  NOT_APPROVED
  APPROVED

  @@map("event_approval_status")
}

enum LocationValidationStatus {
  UNVALIDATED
  VERIFIED
  LOW_CONFIDENCE

  @@map("location_validation_status")
}

enum EventPhotoStatus {
  RESERVED
  UPLOADED
  PROCESSING
  READY
  FAILED

  @@map("event_photo_status")
}

model User {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName       String        @map("display_name") @db.VarChar(100)
  email             String        @db.VarChar(320)
  normalizedEmail   String        @unique @map("normalized_email") @db.VarChar(320)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  role              UserRole      @default(USER)
  status            AccountStatus @default(ACTIVE)
  restrictionReason String?       @map("restriction_reason") @db.VarChar(500)
  restrictedAt      DateTime?     @map("restricted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  emailDeliveries         EmailDelivery[]
  organizerProfile        OrganizerProfile?
  termsAcceptedEvents     Event[]                  @relation("EventTermsAcceptedBy")
  eventApprovals          EventApproval[]          @relation("EventApprovalUser")
  auditEntries            AuditEntry[]             @relation("AuditActor")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  deviceLabel String?  @map("device_label") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  resendCount   Int       @default(0) @map("resend_count")
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  attemptCount  Int       @default(0) @map("attempt_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model OrganizerProfile {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @unique @map("user_id") @db.Uuid
  displayName  String?         @map("display_name") @db.VarChar(100)
  contactName  String?         @map("contact_name") @db.VarChar(100)
  contactEmail String?         @map("contact_email") @db.VarChar(320)
  contactPhone String?         @map("contact_phone") @db.VarChar(32)
  websiteUrl   String?         @map("website_url") @db.VarChar(2048)
  status       OrganizerStatus @default(INCOMPLETE)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         Event[]
  eventApprovals EventApproval[]

  @@index([status])
  @@map("organizer_profiles")
}

model Event {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId           String              @map("organizer_id") @db.Uuid
  publicId              String              @unique @map("public_id") @db.VarChar(12)
  slug                  String              @db.VarChar(100)
  title                 String?             @db.VarChar(120)
  description           String?             @db.VarChar(5000)
  eventType             EventType           @map("event_type")
  origin                EventOrigin         @default(OWNER_CREATED)
  localStartsAt         String?             @map("local_starts_at") @db.VarChar(16)
  localEndsAt           String?             @map("local_ends_at") @db.VarChar(16)
  startsAt              DateTime?           @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime?           @map("ends_at") @db.Timestamptz(3)
  timezone              String?             @db.VarChar(64)
  privacyMode           AddressPrivacyMode? @map("privacy_mode")
  workflowState         EventWorkflowState  @default(INCOMPLETE_DRAFT) @map("workflow_state")
  approvalStatus        EventApprovalStatus @default(NOT_APPROVED) @map("approval_status")
  version               Int                 @default(1)
  contentRevision       Int                 @default(1) @map("content_revision")
  approvedRevision      Int?                @map("approved_revision")
  approvalDigest        String?             @map("approval_digest") @db.Char(64)
  approvedAt            DateTime?           @map("approved_at") @db.Timestamptz(3)
  termsVersion          String?             @map("terms_version") @db.VarChar(50)
  termsAcceptedAt       DateTime?           @map("terms_accepted_at") @db.Timestamptz(3)
  termsAcceptedByUserId String?             @map("terms_accepted_by_user_id") @db.Uuid
  currentApprovalId     String?             @unique @map("current_approval_id") @db.Uuid
  coverPhotoId          String?             @map("cover_photo_id") @db.Uuid
  canceledAt            DateTime?           @map("canceled_at") @db.Timestamptz(3)
  cancellationReason    String?             @map("cancellation_reason") @db.VarChar(500)
  removedAt             DateTime?           @map("removed_at") @db.Timestamptz(3)
  removalReason         String?             @map("removal_reason") @db.VarChar(500)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organizer          OrganizerProfile    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  termsAcceptedBy    User?               @relation("EventTermsAcceptedBy", fields: [termsAcceptedByUserId], references: [id], onDelete: SetNull)
  location           EventLocation?
  photos             EventPhoto[]        @relation("EventPhotos")
  coverPhoto         EventPhoto?         @relation("EventCoverPhoto", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  uploadReservations UploadReservation[]
  approvals          EventApproval[]     @relation("EventApprovals")
  currentApproval    EventApproval?      @relation("CurrentEventApproval", fields: [currentApprovalId], references: [id], onDelete: SetNull)

  @@index([organizerId, updatedAt])
  @@index([workflowState, updatedAt])
  @@index([eventType, startsAt])
  @@map("events")
}

model EventLocation {
  id                String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String                                 @unique @map("event_id") @db.Uuid
  addressLine1      String                                 @map("address_line_1") @db.VarChar(200)
  addressLine2      String?                                @map("address_line_2") @db.VarChar(100)
  city              String                                 @db.VarChar(100)
  region            String                                 @db.VarChar(100)
  postalCode        String                                 @map("postal_code") @db.VarChar(20)
  countryCode       String                                 @map("country_code") @db.Char(2)
  normalizedAddress String                                 @map("normalized_address") @db.VarChar(500)
  latitude          Decimal                                @db.Decimal(9, 6)
  longitude         Decimal                                @db.Decimal(9, 6)
  coordinates       Unsupported("geography(Point, 4326)")?
  timezone          String                                 @db.VarChar(64)
  providerPlaceId   String                                 @map("provider_place_id") @db.VarChar(255)
  providerName      String                                 @map("provider_name") @db.VarChar(50)
  precision         String?                                @db.VarChar(50)
  confidence        Decimal?                               @db.Decimal(5, 4)
  validationStatus  LocationValidationStatus               @map("validation_status")
  createdAt         DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([city, region])
  @@index([validationStatus])
  @@map("event_locations")
}

model EventPhoto {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId                String           @map("event_id") @db.Uuid
  status                 EventPhotoStatus @default(RESERVED)
  sortOrder              Int              @map("sort_order")
  stagingObjectKey       String?          @unique @map("staging_object_key") @db.VarChar(500)
  dashboardThumbnailKey  String?          @unique @map("dashboard_thumbnail_key") @db.VarChar(500)
  listingCardKey         String?          @unique @map("listing_card_key") @db.VarChar(500)
  galleryKey             String?          @unique @map("gallery_key") @db.VarChar(500)
  coverDisplayKey        String?          @unique @map("cover_display_key") @db.VarChar(500)
  dashboardThumbnailHash String?          @map("dashboard_thumbnail_hash") @db.Char(64)
  listingCardHash        String?          @map("listing_card_hash") @db.Char(64)
  galleryHash            String?          @map("gallery_hash") @db.Char(64)
  coverDisplayHash       String?          @map("cover_display_hash") @db.Char(64)
  sourceContentType      String?          @map("source_content_type") @db.VarChar(100)
  sourceSize             Int?             @map("source_size")
  width                  Int?
  height                 Int?
  errorCode              String?          @map("error_code") @db.VarChar(100)
  readyAt                DateTime?        @map("ready_at") @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event             Event              @relation("EventPhotos", fields: [eventId], references: [id], onDelete: Cascade)
  coverForEvents    Event[]            @relation("EventCoverPhoto")
  uploadReservation UploadReservation?

  @@index([eventId, sortOrder])
  @@index([eventId, status])
  @@map("event_photos")
}

model UploadReservation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  photoId          String    @unique @map("photo_id") @db.Uuid
  stagingObjectKey String    @unique @map("staging_object_key") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photo EventPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([eventId, expiresAt])
  @@map("upload_reservations")
}

model EventApproval {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  organizerId      String   @map("organizer_id") @db.Uuid
  acceptedByUserId String   @map("accepted_by_user_id") @db.Uuid
  contentRevision  Int      @map("content_revision")
  approvalDigest   String   @map("approval_digest") @db.Char(64)
  termsVersion     String   @map("terms_version") @db.VarChar(50)
  termsAcceptedAt  DateTime @map("terms_accepted_at") @db.Timestamptz(3)
  approvedAt       DateTime @map("approved_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  event           Event            @relation("EventApprovals", fields: [eventId], references: [id], onDelete: Cascade)
  organizer       OrganizerProfile @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  acceptedByUser  User             @relation("EventApprovalUser", fields: [acceptedByUserId], references: [id], onDelete: Cascade)
  currentForEvent Event?           @relation("CurrentEventApproval")

  @@unique([eventId, contentRevision])
  @@index([eventId, approvedAt])
  @@index([organizerId, approvedAt])
  @@map("event_approvals")
}

model EmailDelivery {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  kind              EmailDeliveryKind
  status            EmailDeliveryStatus @default(PENDING)
  provider          String              @default("resend") @db.VarChar(50)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  recipientHash     String              @map("recipient_hash") @db.Char(64)
  attempts          Int                 @default(0)
  lastErrorCode     String?             @map("last_error_code") @db.VarChar(100)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(3)
  failedAt          DateTime?           @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@index([userId, kind, createdAt])
  @@index([status, createdAt])
  @@map("email_deliveries")
}

model AuditEntry {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(100)
  requestId   String?  @map("request_id") @db.VarChar(100)
  metadata    Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@map("audit_entries")
}

model AuthenticationRateLimitBucket {
  environment     String   @db.VarChar(16)
  scopeHash       String   @map("scope_hash") @db.Char(64)
  namespace       String   @db.VarChar(64)
  identifierHash  String   @map("identifier_hash") @db.Char(64)
  attemptCount    Int      @map("attempt_count")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([environment, scopeHash, namespace, identifierHash])
  @@index([expiresAt])
  @@index([environment, scopeHash, expiresAt])
  @@map("authentication_rate_limit_buckets")
}

model DurableJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue            String    @db.VarChar(50)
  type             String    @db.VarChar(100)
  payload          Json
  status           JobStatus @default(PENDING)
  deduplicationKey String?   @map("deduplication_key") @db.VarChar(200)
  runAt            DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts         Int       @default(0)
  maxAttempts      Int       @default(10) @map("max_attempts")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?   @map("locked_by") @db.VarChar(100)
  lastErrorCode    String?   @map("last_error_code") @db.VarChar(100)
  lastErrorMessage String?   @map("last_error_message") @db.VarChar(1000)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([queue, type, deduplicationKey])
  @@index([status, runAt])
  @@index([lockedAt])
  @@map("durable_jobs")
}
