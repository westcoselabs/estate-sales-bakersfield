{
  "name": "estate-sales-bakersfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Estate and yard sale directory modular monolith",
  "engines": {
    "node": "24.11.1",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "arch:check": "depcruise --config dependency-cruiser.cjs src scripts tests",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify:live": "tsx scripts/verify-live-neon.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract:blob": "vitest run --project blob-contract",
    "test:contract:blob:live": "tsx scripts/run-live-blob-contract.ts",
    "test:e2e": "playwright test",
    "test": "vitest run --project unit --project integration --project blob-contract",
    "auth:benchmark": "tsx scripts/benchmark-argon2.ts",
    "auth:benchmark:vercel": "tsx scripts/benchmark-vercel-argon2.ts",
    "jobs:run": "tsx scripts/run-jobs.ts --once",
    "verify": "tsx scripts/verify.ts offline",
    "verify:live": "tsx scripts/verify.ts live",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-neon": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@sentry/nextjs": "10.66.0",
    "@vercel/blob": "2.6.1",
    "dotenv": "17.4.2",
    "next": "16.2.10",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "prettier": "3.9.5",
    "prisma": "7.8.0",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "webpack": "5.108.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "cpu-features",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp",
      "ssh2",
      "unrs-resolver"
    ],
    "overrides": {
      "@hono/node-server": "1.19.13",
      "postcss": "8.5.10"
    }
  }
}
