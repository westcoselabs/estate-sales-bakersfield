NODE_ENV=development
APP_ENV=local
# Server-only, Production-only release gate. Keep false unless deliberately
# operating the stable Production deployment with Stripe test resources.
PRODUCTION_BETA_MODE=false
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Local development and automated test schemas use Development Neon only.
DATABASE_URL=postgresql://development_user:replace-me@ep-development-identifier-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://development_user:replace-me@ep-development-identifier.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_RESOURCE_ENV=development
DEVELOPMENT_NEON_ENDPOINT_ID=ep-development-identifier
DEVELOPMENT_DATABASE_CONFIRMATION=estate-sales-bakersfield-development-neon-test-schemas

CRON_SECRET=replace-with-at-least-32-random-characters
BLOB_READ_WRITE_TOKEN=
BLOB_RESOURCE_ENV=
AUTH_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
RESEND_FROM=Estate Sales Bakersfield <accounts@example.com>
RESEND_RESOURCE_ENV=
RESEND_WEBHOOK_SECRET=
# Production-only release gate. Local development cannot dispatch campaigns.
EMAIL_CAMPAIGNS_ENABLED=false
# Local/test-only capture under .tmp; deployed environments always use Resend.
AUTH_EMAIL_CAPTURE_PATH=
# Private, server-only. Never prefix this key with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
# Public MapLibre style configuration. Launch default:
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Local uses the deterministic fake by default. Never copy live values here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_EXPECTED_AMOUNT=
STRIPE_EXPECTED_CURRENCY=
STRIPE_MODE=
STRIPE_RESOURCE_ENV=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
VERCEL_BENCHMARK_URL=
