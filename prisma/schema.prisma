  attribution           Json
  publishedAt           DateTime              @map("published_at") @db.Timestamptz(3)
  expiredAt             DateTime?             @map("expired_at") @db.Timestamptz(3)
  removedAt             DateTime?             @map("removed_at") @db.Timestamptz(3)
  removalReason         String?               @map("removal_reason") @db.VarChar(500)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  candidate           ListingImportCandidate      @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  primarySourceRecord ListingSourceRecord         @relation("ExternalListingPrimarySource", fields: [primarySourceRecordId], references: [id], onDelete: Restrict)
  location            ExternalListingLocation?
  duplicateMatches    ListingDuplicateMatch[]     @relation("ListingDuplicateMatchExternalListing")
  linkedSourceRecords ListingSourceRecord[]       @relation("ListingSourceRecordLinkedExternal")
  publicIdReservation ListingPublicIdReservation?

  @@index([status, startsAt, publicId])
  @@index([status, endsAt])
  @@index([eventType, status, startsAt])
  @@index([startsAt, endsAt, id])
  @@map("external_listings")
}

model ListingPublicIdReservation {
  publicId          String   @id @map("public_id") @db.VarChar(12)
  eventId           String?  @unique @map("event_id") @db.Uuid
  externalListingId String?  @unique @map("external_listing_id") @db.Uuid
  reservedAt        DateTime @default(now()) @map("reserved_at") @db.Timestamptz(3)

  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  externalListing ExternalListing? @relation(fields: [externalListingId], references: [id], onDelete: Restrict)

  @@map("listing_public_id_reservations")
}

model ExternalListingLocation {
  id                  String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId           String                                 @unique @map("listing_id") @db.Uuid
  addressLine1        String                                 @map("address_line_1") @db.VarChar(200)
  addressLine2        String?                                @map("address_line_2") @db.VarChar(100)
  city                String                                 @db.VarChar(100)
  region              String                                 @db.VarChar(100)
  postalCode          String                                 @map("postal_code") @db.VarChar(20)
  countryCode         String                                 @map("country_code") @db.Char(2)
  normalizedAddress   String                                 @map("normalized_address") @db.VarChar(500)
  latitude            Decimal?                               @db.Decimal(9, 6)
  longitude           Decimal?                               @db.Decimal(9, 6)
  coordinates         Unsupported("geography(Point, 4326)")?
  timezone            String                                 @db.VarChar(64)
  providerPlaceId     String?                                @map("provider_place_id") @db.VarChar(255)
  providerName        String?                                @map("provider_name") @db.VarChar(50)
  providerVersion     String?                                @map("provider_version") @db.VarChar(50)
  providerAttribution String?                                @map("provider_attribution") @db.VarChar(255)
  resolutionSource    LocationResolutionSource               @default(UNCONFIRMED_DRAFT) @map("resolution_source")
  confirmationStatus  LocationConfirmationStatus             @default(UNCONFIRMED) @map("confirmation_status")
  confirmedByUserId   String?                                @map("confirmed_by_user_id") @db.Uuid
  confirmedAt         DateTime?                              @map("confirmed_at") @db.Timestamptz(3)
  publicZone          String                                 @default("bakersfield") @map("public_zone") @db.VarChar(50)
  precision           String?                                @db.VarChar(50)
  confidence          Decimal?                               @db.Decimal(5, 4)
  validationStatus    LocationValidationStatus               @map("validation_status")
  createdAt           DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(3)

  listing     ExternalListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  confirmedBy User?           @relation("ExternalListingLocationConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict)

  @@index([city, region])
  @@index([validationStatus])
  @@index([confirmationStatus])
  @@map("external_listing_locations")
}
