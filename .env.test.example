NODE_ENV=test
APP_ENV=test
APP_URL=http://127.0.0.1:3417
LOG_LEVEL=silent
# Persistent isolated Test Neon branch. Never reuse Preview or Production.
TEST_DATABASE_URL=postgresql://test_user:replace-me@ep-test-branch-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
TEST_DIRECT_URL=postgresql://test_user:replace-me@ep-test-branch.us-east-2.aws.neon.tech/neondb?sslmode=require
TEST_NEON_ENDPOINT_ID=ep-test-branch
TEST_DATABASE_CONFIRMATION=estate-sales-bakersfield-isolated-test-neon

# Set only for the explicit destructive reset command.
TEST_DATABASE_RESET_CONFIRMATION=

AUTH_FINGERPRINT_SECRET=replace-with-at-least-32-test-only-characters
AUTH_EMAIL_CAPTURE_PATH=.tmp/test-auth-emails.jsonl
TEST_MEDIA_ROOT=.tmp/test-media
TEST_MEDIA_SIGNING_SECRET=replace-with-at-least-32-test-only-characters
TEST_LOCATION_FIXTURES=bakersfield

# Real provider credentials are deliberately absent and stripped by test runners.
